[Unit]
Description=iOS Backup Machine Web UI
# Deliberately not ordered after network-online.target: it took 127 s to
# activate on the appliance, and the UI was unreachable for that whole
# window every boot. BindSupervisor re-resolves the bind addresses on a
# timer, so starting before any interface is up costs nothing.
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/iosbackupmachine
Environment=IOSBACKUP_CONFIG=/root/iosbackupmachine/config.yaml
ExecStart=/root/iosbackupmachine/bin/python3 /root/iosbackupmachine/webui.py
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
