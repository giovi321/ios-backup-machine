# /root/iosbackupmachine/config.yaml
# config_version is managed automatically; do not edit by hand. It tracks the
# schema in app/config_schema.py, which migrates an older file forward on update.
config_version: 4
setup_completed: false
backup_dir: /media/iosbackup/
marker_file: .foldermarker
disk_device: /dev/mmcblk1
orientation: landscape_right
font_path: "/root/iosbackupmachine/UbuntuMono-Regular.ttf"
owner_lines:
  - "Property of Titius Caius"
  - "+33 123 456 7890"
  - "write@titiuscaius.com"
  - "Reward if found €€€"
error_codes:
  "100": "Snapshot failure at path"
  "102": "iPhone out of space. Free space on iPhone and retry."
  "103": "Backup directory is wrong"
  "105": "Insufficient free disk space on backup drive"
  "106": "No space left for the backup"
  "208": "Unlock iPhone and try again"
  "-4":  "iPhone disconnected during backup"

# --- Environment overrides ---
# Exported into the environment of the display daemon and of backup-sync.py at
# startup, so IOSBACKUP_* tuning variables read by those two survive a reboot
# without editing a systemd unit: log retention and the per-file log cap, the
# webhook auth cache TTL. Empty by default.
#
# The web UI does NOT read this block. Anything webui.py reads at import
# (IOSBACKUP_LOG_VIEW_HEAD_LINES / _TAIL_LINES / _MAX_BYTES) has to go in
# webui.service as an Environment= line instead.
env: {}
  # IOSBACKUP_LOG_KEEP: "50"
  # IOSBACKUP_LOG_MAX_AGE_DAYS: "90"

# --- Authentication ---
auth:
  password_hash: ""  # SHA-256 salted hash; empty = no auth required (set via web UI)

# --- Backup behavior ---
# Only auto_start and notify_on_rejected have web UI controls (Backup Settings).
# The guards below are edited here; restart iosbackupmachine.service afterwards,
# except stale_after_sec and notify_stale, which are re-read on every check.
backup:
  auto_start: true          # start backup automatically when iPhone is plugged in
  notify_on_rejected: true   # send notification when a non-allowed device is rejected
  hang_timeout_sec: 600      # idevicebackup2 silent this long -> hung; it is killed
  max_duration_sec: 14400    # total cap for a single backup run (4 h)
  min_battery_percent: 35    # refuse to start / abort mid-run below this when not charging
                             # (PiSugar hard-powers the board off at 30%); 0 disables
  min_free_mb: 512           # free space the backup drive must keep during the run; also
                             # raises the pre-backup floor when higher; 0 disables the
                             # drive check (the root-filesystem check always runs)
  notify_stale: true         # alert once when no backup has succeeded for stale_after_sec
                             # (every other notification only fires when something happens,
                             # so a device that quietly stops backing up tells nobody)
  stale_after_sec: 604800    # no successful backup for this long -> one alert (7 d); the
                             # next successful backup re-arms it; 0 = off

# --- Backup encryption ---
# Encryption is set ON THE iPHONE via the web UI Encryption page.
# The password is NEVER stored on this device, so you must remember it
# yourself (it is only needed to restore backups).
backup_encryption:
  encryption_confirmed: false   # set true once encryption has been verified enabled on a device

# --- Device filter ---
device_filter:
  enabled: false             # if true, only UDIDs in allowed_devices can trigger backup
  allowed_devices: []        # list of {udid: "...", name: "..."} dicts
  # Example:
  # allowed_devices:
  #   - udid: "00008030-001A34E22.."
  #     name: "John's iPhone 15"

# --- WiFi settings ---
# Configure one or more networks; the device joins whichever is in range.
# Managed via netplan + wpa_supplicant (no NetworkManager). ssid/password below
# are the legacy single-network fields, kept mirrored to networks[0] for back-compat.
wifi:
  enabled: false
  ssid: ""
  password: ""
  networks: []
  #  - nickname: "Home"
  #    ssid: "HomeNetwork"
  #    password: "secret"
  #  - nickname: "Office"
  #    ssid: "CorpWiFi"
  #    password: "another-secret"

# --- NTP time sync ---
ntp:
  enabled: true
  servers:
    - "pool.ntp.org"
    - "time.google.com"

# --- Web UI ---
webui:
  enabled: true
  port: 8080
  # Which interfaces the web UI listens on: wifi, usb_iphone, all
  bind_interfaces:
    - "all"
  secret_key: "change-me-to-a-random-string"

# --- Notifications ---
notifications:
  webhook:
    enabled: false
    url: ""
    # Events: backup_start, backup_complete, backup_error, backup_stale,
    # sync_start, sync_complete, sync_error, device_connected,
    # device_disconnected, device_rejected. An empty list means every event.
    events:
      - "backup_complete"
      - "backup_error"
      - "backup_stale"
    # Optional auth header. The header VALUE is encrypted at rest in notify.enc
    # (same AES-256-GCM credential store as WireGuard/sync). Set the value via the
    # web UI. In UDID mode it can only be decrypted while the iPhone is connected,
    # so the resolved header is cached in RAM under /run/iosbackupmachine and
    # reused for the events that fire once the phone is gone. When auth is on and
    # no header can be obtained, the webhook is skipped rather than sent
    # unauthenticated, and the reason goes to the run log.
    auth_enabled: false
    auth_header: "Authorization"
  mqtt:
    enabled: false
    broker: ""
    port: 1883
    username: ""
    password: ""
    topic_prefix: "iosbackupmachine"
    # Same event names as the webhook above; an empty list means every event.
    events:
      - "backup_complete"
      - "backup_error"
      - "backup_stale"

# --- WireGuard client ---
wireguard:
  enabled: false
  interface_name: "wg0"
  auto_connect: false           # connect automatically when a trigger source appears
  auto_connect_on:              # triggers (combinable): iphone, wifi, boot
    - "iphone"
  # full_tunnel: route ALL traffic, including the local subnet, through the VPN,
  # re-applied on every connect. Use it when the remote sync server's IP overlaps
  # the WiFi subnet. Requires AllowedIPs=0.0.0.0/0. SSH / web UI stay reachable from
  # the local network (replies to local connections are kept off the tunnel).
  full_tunnel: false
  # WireGuard config is stored encrypted in /root/iosbackupmachine/wireguard.enc
  # The encryption key is derived from the connected iPhone's UUID (or a custom passphrase)

# --- Credential encryption (WireGuard + remote sync) ---
credential_encryption:
  passphrase_mode: udid   # "udid" (auto-decrypt when iPhone connected) or "custom"

# --- Remote sync (rsync over SSH) ---
sync:
  enabled: false
  auto_sync: false           # sync automatically after each successful backup
  allowed_network: any       # any | wifi | wifi_ssid | usb
  allowed_ssid: ""           # only used when allowed_network is wifi_ssid; the
                             # sync refuses to run on any other SSID
  # Power-aware sync: refuse to start (and auto-abort) a sync when not charging
  # and battery is below this percent. Kept above PiSugar's 30% auto-shutdown so
  # a long rsync isn't cut mid-transfer. SSH credentials live encrypted in sync.enc.
  min_battery_percent: 35
  max_seconds: 0             # overall cap for one sync run, in seconds. 0 = no cap
                             # (default). The stall watchdogs still kill a sync that
                             # has stopped moving; this only bounds one that is working.
